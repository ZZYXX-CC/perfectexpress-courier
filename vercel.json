{
    "framework": "vite",
    "rewrites": [
        {
            "source": "/((?!api/).*)",
            "destination": "/index.html"
        }
    ],
    "crons": [
        {
            "path": "/api/keepalive",
            "schedule": "*/15 * * * *"
        }
    ],
    "outputDirectory": "dist"
}